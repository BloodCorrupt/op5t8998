diff --git a/fs/dcache.c b/fs/dcache.c
index d065854..f45c55b 100644
--- a/fs/dcache.c
+++ b/fs/dcache.c
@@ -39,6 +39,9 @@
 #include <linux/ratelimit.h>
 #include <linux/list_lru.h>
 #include <linux/kasan.h>
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
