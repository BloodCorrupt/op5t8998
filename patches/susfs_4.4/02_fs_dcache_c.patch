+#endif
 
 #include "internal.h"
 #include "mount.h"
@@ -273,6 +276,12 @@ void take_dentry_name_snapshot(struct name_snapshot *name, struct dentry *dentry
 {
 	spin_lock(&dentry->d_lock);
 	if (unlikely(dname_external(dentry))) {
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
