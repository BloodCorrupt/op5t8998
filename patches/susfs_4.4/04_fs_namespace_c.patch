+	struct mount *mnt;
+	struct mnt_namespace *mnt_ns;
+
+	mnt_ns = current->nsproxy->mnt_ns;
+	namespace_lock();
+	list_for_each_entry(mnt, &mnt_ns->list, mnt_list) {
